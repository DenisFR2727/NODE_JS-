   <%- include("../includes/head.ejs") %>
  </head>
  <body>
    <%- include("../includes/navigation.ejs") %>
    <main>
      <h1>Users Page</h1>
      <ul>
         <% if (hasUsers) { %>
            <% users.forEach((user) => { %>
               <li>
                  <p>
                  <%= user.name %>
                  </p>
                  <p>
                     <a href="/users/<%= user.id %>">Details</a>
                  </p>
            </li>
            <% }); %>
            <% } else { %>
               <p>No users yet.</p>
            <% } %>
      </ul>
    </main>
 <%- include("../includes/end.ejs") %>