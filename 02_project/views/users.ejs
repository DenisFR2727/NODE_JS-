<main>
  <% if (hasUsers) { %>
    <ul>
      <% users.forEach((user) => { %>
        <li><%= user.name %></li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>No users yet.</p>
  <% } %>
</main>
