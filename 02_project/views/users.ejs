<%- include("includes/head.ejs") %>
<%- include("includes/navigation.ejs") %>
<main class="main-content">
  <% if (hasUsers) { %>
    <ul>
      <% users.forEach((user) => { %>
        <li class="user-name"><%= user.name %></li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>No users yet.</p>
  <% } %>
</main> 
<%- include("includes/end.ejs") %>
